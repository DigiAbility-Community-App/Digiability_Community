# ─────────────────────────────────────────────────────────────
# ROOT .env.example — Docker infrastructure secrets
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=digiability
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=digiability_db
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

# ── pgAdmin (Dev UI — optional, use: docker compose --profile dev up) ──
PGADMIN_EMAIL=admin@digiability.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050
