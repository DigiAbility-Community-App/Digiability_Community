# ─────────────────────────────────────────────────────────────
# Web App (Vite + React) .env.example
# Copy to .env.local and fill in your values.
# Vite env vars must be prefixed with VITE_ to be exposed to the browser.
# ─────────────────────────────────────────────────────────────

# ── API URLs ──────────────────────────────────────────────────
# Read by apiClient.ts, chatService.ts, socketService.ts, forumService.ts.
# The chat WebSocket URL is derived from VITE_CHAT_SVC_URL by swapping the
# scheme (http→ws, https→wss), so it needs no separate variable.
#
# These are build-time — Vite bakes them into the bundle, not read at runtime.
# This file is the local-dev template — copy it to .env.local.
#
# `vite build` reads .env.production, which is gitignored like .env.local — so
# CI/Vercel builds take these from Project → Environment Variables instead.
# If they are unset there, the build silently falls back to the localhost
# defaults hardcoded in src/services/*, producing a broken bundle.
VITE_USER_SVC_URL=http://localhost:4001
VITE_CHAT_SVC_URL=http://localhost:4002
VITE_FORUM_SVC_URL=http://localhost:4003

# ── Note on serving the web app against the live backend ──────
# user-svc and chat-svc only allow ONE CORS origin (their CLIENT_BASE_URL),
# so that must exactly match the origin the web app is served from, or every
# browser request fails. Native mobile is unaffected (no CORS).
# Over plain http:// the refresh-token cookie is also dropped when the
# backend runs with NODE_ENV=production (cookie is Secure) — serve the
# backend over HTTPS for a working web session.
