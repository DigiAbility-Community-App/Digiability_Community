# ─────────────────────────────────────────────────────────────
# Mobile App (Expo) .env.example
# Copy to .env and update with your values.
# IMPORTANT: All Expo env vars must be prefixed with EXPO_PUBLIC_
# Restart Expo ("npx expo start") after changing these values.
#
# This file only affects local `npx expo start`. EAS builds do NOT read it —
# the preview and production profiles in eas.json carry their own https/wss
# values. This is the only place http:// / ws:// URLs belong.
# ─────────────────────────────────────────────────────────────

# ── Backend endpoints (all required — the app has no fallbacks) ─
# EXPO_PUBLIC_API_URL           → user-svc   (auth, profiles, events)
# EXPO_PUBLIC_CHAT_API_URL      → chat-svc   REST
# EXPO_PUBLIC_CHAT_SOCKET_URL   → chat-svc   WebSocket (path /ws)
# EXPO_PUBLIC_FORUM_API_URL     → forum-svc  REST
# EXPO_PUBLIC_FORUM_SOCKET_URL  → forum-svc  Socket.io (websocket transport)
# EXPO_PUBLIC_ADMIN_API_URL     → admin panel API (maintenance, services)
#
# Android Emulator (AVD):  use 10.0.2.2 (maps to host localhost)
# iOS Simulator:           use localhost or 127.0.0.1
# Physical Device:         use your machine's LAN IP address
#
# Find your LAN IP:
#   macOS:  ipconfig getifaddr en0
#   Linux:  hostname -I | awk '{print $1}'
#   Windows: ipconfig | findstr "IPv4"

# ── Physical Android/iOS device (same Wi-Fi as Mac) ──────────
EXPO_PUBLIC_API_URL=http://<your-lan-ip>:4001
EXPO_PUBLIC_CHAT_API_URL=http://<your-lan-ip>:4002
EXPO_PUBLIC_CHAT_SOCKET_URL=ws://<your-lan-ip>:4002/ws
EXPO_PUBLIC_FORUM_API_URL=http://<your-lan-ip>:4003
EXPO_PUBLIC_FORUM_SOCKET_URL=ws://<your-lan-ip>:4003
EXPO_PUBLIC_ADMIN_API_URL=http://<your-lan-ip>:3001

# ── Android Emulator ─────────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4001
# EXPO_PUBLIC_CHAT_API_URL=http://10.0.2.2:4002
# EXPO_PUBLIC_CHAT_SOCKET_URL=ws://10.0.2.2:4002/ws
# EXPO_PUBLIC_FORUM_API_URL=http://10.0.2.2:4003
# EXPO_PUBLIC_FORUM_SOCKET_URL=ws://10.0.2.2:4003
# EXPO_PUBLIC_ADMIN_API_URL=http://10.0.2.2:3001

# ── iOS Simulator ────────────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://localhost:4001
# EXPO_PUBLIC_CHAT_API_URL=http://localhost:4002
# EXPO_PUBLIC_CHAT_SOCKET_URL=ws://localhost:4002/ws
# EXPO_PUBLIC_FORUM_API_URL=http://localhost:4003
# EXPO_PUBLIC_FORUM_SOCKET_URL=ws://localhost:4003
# EXPO_PUBLIC_ADMIN_API_URL=http://localhost:3001

# ── Live backend (HTTPS) ─────────────────────────────────────
# EXPO_PUBLIC_API_URL=https://api.community.digiability.in
# EXPO_PUBLIC_CHAT_API_URL=https://chat.community.digiability.in
# EXPO_PUBLIC_CHAT_SOCKET_URL=wss://chat.community.digiability.in/ws
# EXPO_PUBLIC_FORUM_API_URL=https://forum.community.digiability.in
# EXPO_PUBLIC_FORUM_SOCKET_URL=wss://forum.community.digiability.in
# EXPO_PUBLIC_ADMIN_API_URL=https://admin.community.digiability.in
