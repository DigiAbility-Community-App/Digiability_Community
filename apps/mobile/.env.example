# ─────────────────────────────────────────────────────────────
# Mobile App (Expo) .env.example
# Copy to .env and update with your values.
# IMPORTANT: All Expo env vars must be prefixed with EXPO_PUBLIC_
# Restart Expo ("npx expo start") after changing these values.
# ─────────────────────────────────────────────────────────────

# ── Backend service URLs ──────────────────────────────────────
# EXPO_PUBLIC_API_BASE_URL   → user-svc  (auth, profiles, events)
# EXPO_PUBLIC_CHAT_API_URL   → chat-svc  (REST + WebSocket at /ws)
# EXPO_PUBLIC_FORUM_API_URL  → forum-svc (REST + Socket.io)
# EXPO_PUBLIC_ADMIN_API_URL  → admin panel (admin API)
#
# If CHAT/FORUM vars are omitted, they are derived from the API base
# by replacing port 4001 → 4002/4003 (works for local dev only —
# always set all three explicitly for non-4001 deployments).
#
# Android Emulator (AVD):  use 10.0.2.2 (maps to host localhost)
# iOS Simulator:           use localhost or 127.0.0.1
# Physical Device:         use your machine's LAN IP address
# Production/store builds: use the live server URLs
#
# Find your LAN IP:
#   macOS:  ipconfig getifaddr en0
#   Linux:  hostname -I | awk '{print $1}'
#   Windows: ipconfig | findstr "IPv4"

# ── LIVE server (Play Store / App Store builds) ──────────────
EXPO_PUBLIC_API_BASE_URL=http://<server-ip>:30501
EXPO_PUBLIC_CHAT_API_URL=http://<server-ip>:30502
EXPO_PUBLIC_FORUM_API_URL=http://<server-ip>:30503
EXPO_PUBLIC_ADMIN_API_URL=http://<admin-host>:3001

# ── Physical Android/iOS device (same Wi-Fi as Mac) ──────────
# EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:4001
# EXPO_PUBLIC_CHAT_API_URL=http://<your-lan-ip>:4002
# EXPO_PUBLIC_FORUM_API_URL=http://<your-lan-ip>:4003

# ── Android Emulator ─────────────────────────────────────────
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4001
# EXPO_PUBLIC_CHAT_API_URL=http://10.0.2.2:4002
# EXPO_PUBLIC_FORUM_API_URL=http://10.0.2.2:4003

# ── iOS Simulator ────────────────────────────────────────────
# EXPO_PUBLIC_API_BASE_URL=http://localhost:4001
# EXPO_PUBLIC_CHAT_API_URL=http://localhost:4002
# EXPO_PUBLIC_FORUM_API_URL=http://localhost:4003

# ── Web App URL (for Privacy Policy / Terms links) ────────────
# Set to the public web app URL in production.
# [LEGAL PLACEHOLDER] Replace with production domain before launch —
# both app stores require a reachable privacy policy URL to approve a build.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000

# ── TODO ──────────────────────────────────────────────────────
# Set to the deployed web app URL once it exists — Terms/Privacy
# links on the Welcome screen point here, and store review requires a
# working privacy policy URL.
# EXPO_PUBLIC_WEB_BASE_URL=https://<deployed-web-app>

# ── Store builds ──────────────────────────────────────────────
# This file only affects local `npx expo start`. EAS builds do NOT read it —
# each profile in eas.json carries its own `env` block, so update the URLs
# there when they change. See apps/mobile/README.md.
