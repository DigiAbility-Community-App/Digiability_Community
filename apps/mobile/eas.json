{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.14.1",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "24.14.1",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.community.digiability.in",
        "EXPO_PUBLIC_CHAT_API_URL": "https://chat.community.digiability.in",
        "EXPO_PUBLIC_CHAT_SOCKET_URL": "wss://chat.community.digiability.in/ws",
        "EXPO_PUBLIC_FORUM_API_URL": "https://forum.community.digiability.in",
        "EXPO_PUBLIC_FORUM_SOCKET_URL": "wss://forum.community.digiability.in",
        "EXPO_PUBLIC_ADMIN_API_URL": "https://admin.community.digiability.in"
      }
    },
    "production": {
      "node": "24.14.1",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.community.digiability.in",
        "EXPO_PUBLIC_CHAT_API_URL": "https://chat.community.digiability.in",
        "EXPO_PUBLIC_CHAT_SOCKET_URL": "wss://chat.community.digiability.in/ws",
        "EXPO_PUBLIC_FORUM_API_URL": "https://forum.community.digiability.in",
        "EXPO_PUBLIC_FORUM_SOCKET_URL": "wss://forum.community.digiability.in",
        "EXPO_PUBLIC_ADMIN_API_URL": "https://admin.community.digiability.in"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
