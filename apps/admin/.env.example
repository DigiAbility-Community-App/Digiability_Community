# ─────────────────────────────────────────────────────────────
# Admin Panel (Next.js) .env.example
# Copy to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development

# Admin's own public URL — used for the post-logout redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Database (PostgreSQL) ─────────────────────────────────────
# Direct DB connection used by admin API routes for raw SQL queries.
DATABASE_URL="postgresql://digiability:your_postgres_password@localhost:5432/digiability_db"

# ── Admin Session JWT ─────────────────────────────────────────
# Secret used to sign/verify the admin session cookie.
# Generate: openssl rand -hex 32
# IMPORTANT: This is SEPARATE from user-svc JWT keys — admin uses
# a symmetric secret for its own session, not RS256.
JWT_SECRET=replace_with_64_char_random_string_never_commit_this

# ── Backend Service URLs ──────────────────────────────────────
# Most admin API routes query PostgreSQL directly (see DATABASE_URL above);
# only a few proxy to backend services.
#
# USER_SVC_URL — moderation routes (flags, keywords, audit, review).
# CHAT_SVC_URL — group deletion (falls back to a direct DB write if this or
#                INTERNAL_API_SECRET is unset, so set both together).
USER_SVC_URL=http://localhost:4001
CHAT_SVC_URL=http://localhost:4002

# Reserved — declared for completeness but not referenced by admin code today.
FORUM_SVC_URL=http://localhost:4003
NOTIF_SVC_URL=http://localhost:4004

# ── Internal service-to-service auth ─────────────────────────
# Sent as the `x-internal-secret` header when proxying to user-svc/chat-svc.
# Must match INTERNAL_API_SECRET in those services.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=your_internal_api_secret
