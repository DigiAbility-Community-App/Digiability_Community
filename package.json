{
  "name": "digiability-community",
  "version": "1.0.0",
  "private": true,
  "description": "Digiability Community — Turborepo Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "user-svc:dev": "npm run dev --workspace=@digiability/user-svc",
    "user-svc:migrate": "npm run db:migrate --workspace=@digiability/user-svc",
    "user-svc:generate": "npm run db:generate --workspace=@digiability/user-svc",
    "chat-svc:dev": "npm run dev --workspace=@digiability/chat-svc",
    "chat-svc:migrate": "npm run db:migrate --workspace=@digiability/chat-svc",
    "chat-svc:generate": "npm run db:generate --workspace=@digiability/chat-svc",
    "chat-svc:worker:msg": "npm run worker:msg --workspace=@digiability/chat-svc",
    "chat-svc:worker:delivery": "npm run worker:delivery --workspace=@digiability/chat-svc",
    "group-svc:dev": "npm run dev --workspace=@digiability/group-svc",
    "notif-svc:dev": "npm run dev --workspace=@digiability/notif-svc",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "prisma": "^5.10.0",
    "turbo": "^2.0.0"
  },
  "overrides": {
    "@types/react": "~19.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0"
  }
}
