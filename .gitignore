# ─────────────────────────────────────────────────────────────
# .gitignore — Digiability Community Monorepo
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
.next/
out/
.expo/

# ── Environment variables (NEVER commit real .env files) ──────
.env
.env.local
.env.*.local
.env.development
.env.production

# ── Secrets that must never be committed ──────────────────────
# The admin panel's credential store. It holds bcrypt hashes for the admin
# accounts and was previously tracked — offline-crackable, then directly
# usable against a login that had no rate limiting. The app recreates this
# file on first run, so it does not need to be in the repo.
apps/admin/data/credentials.json

# ── Prisma ────────────────────────────────────────────────────
# Keep migrations in git, but not the generated client
**/generated/

# ── Turbo ─────────────────────────────────────────────────────
.turbo/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── RSA Keys (NEVER commit private keys) ─────────────────────
*.pem
private.key
public.key

# ── Docker volumes / local data ───────────────────────────────
docker/volumes/

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript build info ─────────────────────────────────────
*.tsbuildinfo

# ── AI / Agent config ────────────────────────────────────────
.gemini/
.agents/

# ── Temporary / one-off scripts ──────────────────────────────
*.command
replace_invalid_vars.py

# ── Misc ─────────────────────────────────────────────────────
*.pdf

# ── Local manual Docker image exports (docker save output) ───
apps/admin/admin-*.tar

# Expo CNG: native projects are generated by `expo prebuild` / EAS, never committed
apps/mobile/android/
apps/mobile/ios/
