# ─────────────────────────────────────────────────────────────
# .gitignore — Digiability Community Monorepo
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
.next/
out/
.expo/

# ── Environment variables (NEVER commit real .env files) ──────
.env
.env.local
.env.*.local
.env.development
.env.production

# ── Prisma ────────────────────────────────────────────────────
# Keep migrations in git, but not the generated client
**/generated/

# ── Turbo ─────────────────────────────────────────────────────
.turbo/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── RSA Keys (NEVER commit private keys) ─────────────────────
*.pem
private.key
public.key

# ── Docker volumes / local data ───────────────────────────────
docker/volumes/

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/
