# ─────────────────────────────────────────────────────────────
# notif-svc .env.example
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4004
NODE_ENV=production

# ── Database (PostgreSQL — public schema) ─────────────────────
# No Prisma here — raw `pg` Pool, reads the `device_tokens` table directly.
DATABASE_URL="postgresql://digiability:your_postgres_password@localhost:5432/digiability_db"

# ── Redis (Stream consumer: msg:notify, forum:notify) ─────────
REDIS_URL=redis://:your_redis_password@localhost:6379

# ── Push notifications ────────────────────────────────────────
# Uses expo-server-sdk with no access token required for standard sends.
# No SMTP/email config needed — this service is push-only.
