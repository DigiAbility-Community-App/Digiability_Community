// This is your Prisma schema file for the user-svc (Auth + User Management)
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────
enum Role {
  pwd
  caregiver
  therapist
  ngo
  other
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String
  phoneNo         String?
  lastSeen        DateTime?
  isEmailVerified Boolean  @default(false)
  role            Role?
  profileComplete Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  pwdProfile               PWDProfile?
  caregiverProfile         CaregiverProfile?
  therapistProfile         TherapistProfile?
  ngoProfile               NGOProfile?

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────
// PWD PROFILE (Person with Disability)
// ─────────────────────────────────────────────
model PWDProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  username        String?  @unique
  dob             DateTime?
  disabilityType  String?  // Visual, Hearing, Physical, Cognitive, Multiple, etc.
  disabilitySince Int?     // Year
  
  // Address
  houseNo         String?
  street          String?
  city            String?
  district        String?
  state           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([username])
  @@map("pwd_profiles")
}

// ─────────────────────────────────────────────
// CAREGIVER PROFILE (Parent/Caregiver)
// ─────────────────────────────────────────────
model CaregiverProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  
  // Person they care for
  careeName       String?
  relation        String?  // Son, Daughter, Father, Mother, etc.
  careeDob        DateTime?
  careDisability  String?
  careSince       Int?     // Year
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("caregiver_profiles")
}

// ─────────────────────────────────────────────
// THERAPIST PROFILE (Educator/Therapist)
// ─────────────────────────────────────────────
model TherapistProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  username            String?  @unique
  dob                 DateTime?
  
  // Professional Info
  specialty           String?
  institution         String?
  yearsOfExperience   Int?
  
  // Focus Areas (Disabilities they work with)
  focusAreas          String[] @default([]) // Visual, Hearing, Physical, Cognitive, Multiple
  
  // Location
  city                String?
  district            String?
  state               String?
  
  verificationStatus  String?  @default("pending") // pending, verified, rejected
  verificationDoc     String?  // URL to uploaded document
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([username])
  @@index([verificationStatus])
  @@map("therapist_profiles")
}

// ─────────────────────────────────────────────
// NGO PROFILE (Organization)
// ─────────────────────────────────────────────
model NGOProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  
  // Organization Info
  contactPersonName   String?
  username            String?  @unique
  organizationName    String?
  registrationNumber  String?
  organizationType    String?  // Trust, NGO, Foundation, Company, etc.
  
  // Services Offered
  servicesOffered     String[] @default([]) // Therapy, Education, Training, Assistive Tech, Counselling, Other
  
  // Location
  city                String?
  pincode             String?
  
  // Additional
  website             String?
  
  verificationStatus  String?  @default("pending") // pending, verified, rejected
  verificationDoc     String?  // URL to uploaded document
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([username])
  @@index([verificationStatus])
  @@map("ngo_profiles")
}

// ─────────────────────────────────────────────
// EMAIL VERIFICATION TOKEN
// ─────────────────────────────────────────────
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   // stored as SHA-256 hash
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// PASSWORD RESET TOKEN
// ─────────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}
