// This is your Prisma schema file for the user-svc (Auth + User Management)
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────
enum Role {
  pwd
  caregiver
  therapist
  ngo
  volunteer
  student
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  phoneNo         String?
  lastSeen        DateTime?
  isEmailVerified Boolean   @default(false)
  roles           Role[]    @default([])
  profileComplete Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userProfile             UserProfile?

  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────
// USER PROFILE
// One profile per user. Role is stored on User.role
// (pwd, caregiver, therapist, ngo, volunteer, student).
// All users fill the same profile form.
// ─────────────────────────────────────────────
model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  username  String?   @unique
  fullName  String?
  dob       DateTime?
  gender    String?
  city      String?
  state     String?

  // PwD Fields
  disabilityType  String?
  disabilitySince Int?
  supportNeeded   String?

  // Caregiver Fields
  carePersonName     String?
  careRelation       String?
  careDob            DateTime?
  careDisabilityType String?

  // Therapist Fields
  speciality        String?
  organization      String?
  yearsOfExperience Int?

  // NGO Fields
  ngoName           String?
  ngoRole           String?
  district          String?

  // Verification (for Therapist / NGO roles)
  verificationStatus String?  @default("pending") // pending, verified, rejected
  verificationDoc    String?  // URL to uploaded document

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([username])
  @@map("user_profiles")
}

// ─────────────────────────────────────────────
// EMAIL VERIFICATION TOKEN
// ─────────────────────────────────────────────
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   // stored as SHA-256 hash
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// PASSWORD RESET TOKEN
// ─────────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// EVENT
// ─────────────────────────────────────────────
model Event {
  id          String   @id @default(uuid())
  title       String
  category    String
  location    String
  date        String
  time        String?
  image       String
  description String
  spots       Int      @default(50)
  buttonType  String   @default("filled")
  externalUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

