// This is your Prisma schema file for the user-svc (Auth + User Management)
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────
enum Role {
  pwd
  caregiver
  therapist
  ngo
  volunteer
  student
  mentor
}

enum ReportTargetType {
  USER
  MESSAGE
  GROUP
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  phoneNo         String?
  lastSeen        DateTime?
  isEmailVerified Boolean   @default(false)
  roles           Role[]    @default([])
  profileComplete Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userProfile             UserProfile?
  mentorProfile           MentorProfile?
  givenReviews            MentorReview[]  @relation("ReviewerRelation")
  deviceTokens            DeviceToken[]
  filedReports            UserReport[]    @relation("ReporterRelation")

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────
// DEVICE TOKEN
// Stores Expo push tokens for push notifications.
// One user can have multiple tokens (multiple devices).
// ─────────────────────────────────────────────
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // 'ios' | 'android'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─────────────────────────────────────────────
// USER PROFILE
// One profile per user. Role is stored on User.role
// (pwd, caregiver, therapist, ngo, volunteer, student).
// All users fill the same profile form.
// ─────────────────────────────────────────────
model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  username  String?   @unique
  fullName  String?
  dob       DateTime?
  gender    String?
  city      String?
  state     String?

  // PwD Fields
  disabilityType  String?
  disabilitySince Int?
  supportNeeded   String?

  // Caregiver Fields
  carePersonName     String?
  careRelation       String?
  careDob            DateTime?
  careDisabilityType String?

  // Therapist Fields
  speciality        String?
  organization      String?
  yearsOfExperience Int?

  // NGO Fields
  ngoName           String?
  ngoRole           String?
  district          String?

  // Verification (for Therapist / NGO roles)
  verificationStatus String?  @default("pending") // pending, verified, rejected
  verificationDoc    String?  // URL to uploaded document

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([username])
  @@map("user_profiles")
}

// ─────────────────────────────────────────────
// EMAIL VERIFICATION TOKEN
// ─────────────────────────────────────────────
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  attempts  Int      @default(0)  // failed attempt counter for brute-force protection
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   // stored as SHA-256 hash
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// PASSWORD RESET TOKEN
// ─────────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// EVENT
// ─────────────────────────────────────────────
model Event {
  id                 String   @id @default(uuid())
  title              String
  category           String
  location           String
  date               String
  time               String?
  image              String
  description        String
  spots              Int      @default(50)
  buttonType         String   @default("filled")
  externalUrl        String
  organizer          String   @default("DigiAbility Admin")
  accessibility_tags String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("events")
}

// ─────────────────────────────────────────────
// MENTOR PROFILE
// ─────────────────────────────────────────────
model MentorProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  bio                   String?
  skills                String[]
  disabilitySpecialties String[]
  isAvailable           Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews               MentorReview[]

  @@index([isAvailable])
  @@map("mentor_profiles")
}

// ─────────────────────────────────────────────
// MENTOR REVIEW
// One review per reviewer per mentor
// ─────────────────────────────────────────────
model MentorReview {
  id         String        @id @default(uuid())
  mentorId   String
  reviewerId String
  rating     Int           // 1-5
  comment    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  mentor     MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  reviewer   User          @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([mentorId, reviewerId])
  @@index([mentorId])
  @@map("mentor_reviews")
}

// ─────────────────────────────────────────────
// USER REPORT
// Unified report table for users, chat messages, and groups.
// Consumed by the admin moderation queue (Phase 3).
// Unique constraint prevents duplicate reports from the same reporter.
// ─────────────────────────────────────────────
model UserReport {
  id          String           @id @default(uuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String           // userId | messageId | conversationId
  reason      ReportReason
  details     String?          // optional free-text, max 500 chars
  status      ReportStatus     @default(PENDING)
  reviewedBy  String?          // admin userId who reviewed
  reviewedAt  DateTime?
  actionTaken String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter User @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("user_reports")
}

