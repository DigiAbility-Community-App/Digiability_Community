# ─────────────────────────────────────────────────────────────
# user-svc .env.example
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4001
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────
# Local dev — Postgres running in Docker on your machine:
DATABASE_URL="postgresql://digiability:your_postgres_password@localhost:5432/digiability_db?schema=public"
# When user-svc runs INSIDE Docker Compose, docker-compose.yml overrides this
# automatically to use the container hostname "postgres" instead of "localhost".

# ── JWT (RS256) ───────────────────────────────────────────────
# Generate a fresh key pair (do this once per environment):
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste below with literal \n (not actual line breaks):
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<your private key>\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your public key>\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=15m

# ── Refresh Token ─────────────────────────────────────────────
REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Cookie ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
COOKIE_SECRET=replace_with_64_char_random_string

# ── Email (SMTP via Nodemailer) ───────────────────────────────
# Gmail: enable 2FA → https://myaccount.google.com/apppasswords → create App Password
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_16_char_app_password
EMAIL_FROM="Digiability <noreply@digiability.com>"

# ── Frontend Base URL ─────────────────────────────────────────
# Two jobs: (1) the links in verification/reset emails, and (2) the single
# allowed CORS origin when NODE_ENV=production. In production it must exactly
# match the origin the web app is served from (scheme + host + port) or every
# browser request is blocked. Native mobile is unaffected (no CORS).
CLIENT_BASE_URL=http://localhost:3000

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:your_redis_password@localhost:6379

# ── Dev helpers ───────────────────────────────────────────────
# Set to "true" to print OTPs and reset links to stdout during local development.
# Never enable in staging or production — use a local SMTP catcher (Mailpit) instead.
DEBUG_AUTH=false

# ── AI Moderation (Tier C + D) ───────────────────────────────
# Optional. Without API keys, classification runs in noop mode.

# Tier C — Text classification (OpenAI Moderation API, free tier)
OPENAI_API_KEY=sk-...

# Tier D — Image classification (Google Cloud Vision SafeSearch)
# Free tier: 1 000 requests/month. Get a key at console.cloud.google.com
# Enable "Cloud Vision API" → Credentials → API Key
GOOGLE_VISION_API_KEY=AIza...

# Minimum AI score (0-1) to write a ModerationFlag row (default: 0.5)
MODERATION_FLAG_THRESHOLD=0.5

# ── Internal service-to-service calls ────────────────────────
# Both are used by deleteAccount (DPDP erasure) and are best-effort: if either
# URL or INTERNAL_API_SECRET is unset, that cleanup is SILENTLY SKIPPED and the
# user's data lingers in that service. Set all three in any real environment.
#
# CHAT_SVC_URL  — removes the user from all chat conversations.
#                 http://localhost:4002 (local) | http://chat-svc:4002 (Compose)
CHAT_SVC_URL=http://localhost:4002
# FORUM_SVC_URL — anonymises the user's forum posts to "Deleted User"
#                 (threads are preserved, not removed).
#                 http://localhost:4003 (local) | http://forum-svc:4003 (Compose)
FORUM_SVC_URL=http://localhost:4003
# Shared secret validated by chat-svc's internal middleware.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=replace_with_64_char_random_string
