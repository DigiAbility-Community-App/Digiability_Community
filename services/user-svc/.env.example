# ─────────────────────────────────────────────────────────────
# USER-SVC — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4001
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/digiability_users?schema=public"

# ── JWT (RS256) ───────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the content (with \n for newlines) here:
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=15m

# ── Refresh Token ─────────────────────────────────────────────
REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Cookie ───────────────────────────────────────────────────
COOKIE_SECRET=replace_with_a_strong_random_string

# ── Email (SMTP via Nodemailer) ───────────────────────────────
# For Gmail: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_here

EMAIL_FROM="Digiability <noreply@digiability.com>"

# ── Frontend Base URL (for email links) ──────────────────────
CLIENT_BASE_URL=http://localhost:3000

# ── Redis (optional, for future caching) ─────────────────────
# REDIS_URL=redis://localhost:6379
