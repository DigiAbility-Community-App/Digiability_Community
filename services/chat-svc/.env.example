# ─────────────────────────────────────────────────────────────
# chat-svc .env.example
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4002
NODE_ENV=development
# Unique ID for this server instance (used in Redis session registry for multi-instance routing)
SERVER_ID=chat-svc-local-01

# ── Database (PostgreSQL — schema=chat) ──────────────────────
# Note: chat-svc uses a separate schema called "chat", not "public"
DATABASE_URL="postgresql://digiability:your_postgres_password@localhost:5432/digiability_db?schema=chat"
# When running inside Docker Compose, this is overridden to use "postgres" hostname automatically.

# ── Redis ─────────────────────────────────────────────────────
# Used for: Redis Streams (message pipeline), Pub/Sub (cross-server delivery), session registry
REDIS_URL=redis://:your_redis_password@localhost:6379

# ── JWT (RS256 — PUBLIC KEY ONLY) ────────────────────────────
# chat-svc only VERIFIES tokens — it never signs them.
# Use the SAME public key as user-svc (copy it from services/user-svc/.env).
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<same public key as user-svc>\n-----END PUBLIC KEY-----"

# ── Frontend Base URL (used in CORS) ─────────────────────────
CLIENT_BASE_URL=http://localhost:3000

# ── WebSocket Session Registry TTL ───────────────────────────
# How long (seconds) a session entry stays in Redis before expiring
REGISTRY_TTL_SECONDS=120
# How often (ms) the server sends heartbeat pings to refresh session TTL
HEARTBEAT_INTERVAL_MS=30000

# ── Internal service-to-service auth ─────────────────────────
# Must match INTERNAL_API_SECRET in user-svc. Guards /api/internal/* routes.
INTERNAL_API_SECRET=replace_with_64_char_random_string
