// ─────────────────────────────────────────────────────────────
// Prisma Schema — chat-svc
// Owns: Conversations, Messages, Delivery State, Receipts
// Uses separate PostgreSQL schema ("chat") to avoid coupling
// with user-svc tables. Users are referenced by ID only.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ConversationType {
  DIRECT
  GROUP
}

enum GroupSubType {
  GENERAL
  CARE_CIRCLE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  CAREGIVER      // Care Circle: full management access like co-owner
  MENTOR         // Care Circle: doctors, therapists
  PROFESSIONAL   // Care Circle: other professionals
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  SYSTEM
}

enum MessageStatus {
  CREATED     // Accepted into stream, not yet persisted
  PERSISTED   // Written to DB
  DELETED     // Soft-deleted
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  READ
}

enum ReceiptType {
  SENT
  DELIVERED
  READ
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  AWAITING_APPROVAL
}

// ─────────────────────────────────────────────
// CONVERSATION
// Represents a 1:1 DM or a group/care-circle
// ─────────────────────────────────────────────
model Conversation {
  id          String           @id @default(uuid())
  type        ConversationType
  subType     GroupSubType?     // null for DMs, GENERAL or CARE_CIRCLE for groups
  name        String?          // null for DMs, set for groups
  description String?          // optional group description
  avatarUrl   String?
  createdBy   String           // userId who created it
  maxMembers  Int              @default(256)  // 15 for care circles, 256 for groups
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?        // soft delete

  // WhatsApp-style group permission settings
  // Values: "ADMINS_ONLY" | "ALL_MEMBERS"
  editGroupInfo  String        @default("ADMINS_ONLY")
  addMembers     String        @default("ADMINS_ONLY")
  sendMessages   String        @default("ALL_MEMBERS")

  // WhatsApp-style: when enabled, non-admin joins require admin approval
  approveNewMembers Boolean    @default(false)

  // Denormalized for fast query: last message preview
  lastMessageId   String?
  lastMessageAt   DateTime?
  lastMessageText String?

  members  ConversationMember[]
  messages Message[]
  invites  GroupInvite[]

  @@index([type])
  @@index([subType])
  @@index([lastMessageAt(sort: Desc)])
  @@index([createdBy])
  @@map("conversations")
}

// ─────────────────────────────────────────────
// CONVERSATION MEMBER
// Links users to conversations with roles + read cursors
// ─────────────────────────────────────────────
model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  role           MemberRole @default(MEMBER)

  // Read cursor: the sequence number of the last message this user has read
  // in this conversation. Used for unread count and reconnect sync.
  lastReadSequenceNo BigInt   @default(0)

  // User preferences for this conversation
  isMuted        Boolean  @default(false)
  isPinned       Boolean  @default(false)

  joinedAt       DateTime @default(now())
  leftAt         DateTime?  // null = active member
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([userId, leftAt])  // For listing active conversations
  @@map("conversation_members")
}

// ─────────────────────────────────────────────
// GROUP INVITE
// Invitation to join a group/care-circle.
// Requires accept/decline before member is added.
// ─────────────────────────────────────────────
model GroupInvite {
  id              String       @id @default(uuid())
  conversationId  String
  inviterId       String       // userId who sent the invite
  inviteeId       String       // userId being invited
  role            MemberRole   @default(MEMBER)  // role assigned on accept
  message         String?      // optional invite message
  status          InviteStatus @default(PENDING)

  respondedAt     DateTime?
  expiresAt       DateTime     // auto-expire after 7 days
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([conversationId, status])
  @@index([conversationId, inviteeId])
  @@map("group_invites")
}

// ─────────────────────────────────────────────
// MESSAGE
// Full message row — content, type, status, metadata all stored here.
// clientMessageId is used for idempotent upserts from the worker.
// ─────────────────────────────────────────────
model Message {
  id              String        @id @default(uuid())
  conversationId  String
  senderId        String
  clientMessageId String        @unique
  sequenceNo      BigInt
  content         String
  type            MessageType   @default(TEXT)
  status          MessageStatus @default(CREATED)
  metadata        String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipients   MessageRecipient[]
  receipts     MessageReceipt[]

  @@index([conversationId, sequenceNo(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([clientMessageId])
  @@map("messages")
}

// ─────────────────────────────────────────────
// MESSAGE RECIPIENT
// Per-user delivery state for each message.
// One row per (message, recipient user). NOT per device —
// delivery to any device marks the user as delivered.
// ─────────────────────────────────────────────
model MessageRecipient {
  id          String         @id @default(uuid())
  messageId   String
  userId      String         // recipient userId

  status      DeliveryStatus @default(PENDING)
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, status])
  @@index([messageId])
  @@map("message_recipients")
}

// ─────────────────────────────────────────────
// MESSAGE RECEIPT
// Audit log of receipt events. Immutable append-only.
// Used for debugging, analytics, and receipt history.
// ─────────────────────────────────────────────
model MessageReceipt {
  id          String      @id @default(uuid())
  messageId   String
  userId      String
  type        ReceiptType
  deviceId    String?     // which device sent this receipt
  
  createdAt   DateTime    @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@map("message_receipts")
}

// ─────────────────────────────────────────────
// OUTBOX EVENT
// Transactional outbox pattern: if the Redis XADD fails after
// DB commit, a background sweep picks up unsent events.
// Provides at-least-once guarantee for event emission.
// ─────────────────────────────────────────────
model OutboxEvent {
  id          String   @id @default(uuid())
  streamName  String
  eventType   String
  payload     String   // JSON
  published   Boolean  @default(false)
  retryCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  publishedAt DateTime?

  @@index([published, createdAt])
  @@index([streamName, published])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────
// HIDDEN MESSAGE (Delete for Me)
// Per-user message hiding — does not affect other users
// ─────────────────────────────────────────────
model HiddenMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
  @@index([userId])
  @@map("hidden_messages")
}

