# ─────────────────────────────────────────────────────────────
# forum-svc .env.example
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4003
NODE_ENV=development

# ── Database (PostgreSQL) ─────────────────────────────────────
# forum-svc uses its own schema on the shared PostgreSQL instance
DATABASE_URL="postgresql://digiability:your_postgres_password@localhost:5432/digiability_db?schema=forum"

# ── JWT (RS256 — PUBLIC KEY ONLY) ────────────────────────────
# Used to verify user tokens from user-svc.
# Copy from services/user-svc/.env
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<same public key as user-svc>\n-----END PUBLIC KEY-----"

# ── Notification Service ──────────────────────────────────────
# URL of notif-svc for sending in-app notifications on new forum activity
NOTIF_SVC_URL=http://localhost:4004
