# ─────────────────────────────────────────────────────────────
# forum-svc .env.example
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=4003
NODE_ENV=development

# ── Database (PostgreSQL — public schema, SHARED with user-svc) ──
# forum-svc's tables live in "public" alongside user-svc's — NOT in a
# separate "forum" schema. Leave the schema param off (Postgres defaults to
# public); docker-compose.yml passes the URL without one too.
#
# ⚠️  Because the schema is shared, `prisma db push` from EITHER service will
# drop the other's tables unless both schema.prisma files keep their inert
# stub mirror models in sync. Prefer `prisma migrate deploy` outside local dev.
DATABASE_URL="postgresql://digiability:your_postgres_password@localhost:5432/digiability_db"

# ── JWT (RS256 — PUBLIC KEY ONLY) ────────────────────────────
# Used to verify user tokens from user-svc.
# Copy from services/user-svc/.env
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<same public key as user-svc>\n-----END PUBLIC KEY-----"

# ── Notification Service ──────────────────────────────────────
# URL of notif-svc for sending push notifications on new forum activity.
# Local: http://localhost:4004 | Docker Compose: http://notif-svc:4004
# Always set this explicitly — the in-code fallback is wrong (it points at
# forum-svc's own port, 4003), so an unset value silently breaks push.
NOTIF_SVC_URL=http://localhost:4004

# ── Redis (optional) ──────────────────────────────────────────
# Used by the moderation middleware and the banned-keyword cache.
# Optional: if unset, those paths degrade gracefully (no cache) rather than
# failing — but set it in any real environment.
REDIS_URL=redis://:your_redis_password@localhost:6379

# ── Internal service-to-service auth ─────────────────────────
# Guards DELETE /api/internal/users/:userId/content — called by user-svc on
# account deletion to anonymise this user's forum posts.
# Must match INTERNAL_API_SECRET in user-svc.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=your_internal_api_secret
