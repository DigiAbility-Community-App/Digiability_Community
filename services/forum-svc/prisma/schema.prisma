generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionStatus {
  SOLVED
  UNSOLVED
}

enum VoteType {
  UP
  DOWN
}

model ForumQuestion {
  id           String          @id @default(uuid())
  title        String
  description  String?
  category     String
  tags         ForumTag[]      @relation("QuestionTags")
  imageUrl     String?
  altText      String?
  audioUrl     String?
  views        Int             @default(0)
  answerCount  Int             @default(0)
  status       QuestionStatus  @default(UNSOLVED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  authorId     String
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers      ForumAnswer[]
  reports      ForumReport[]
  bookmarks    Bookmark[]

  @@index([title])
  @@index([category])
  @@index([createdAt])
  @@index([authorId])
  @@index([deletedAt])

  @@map("forum_questions")
}

model ForumAnswer {
  id          String        @id @default(uuid())
  questionId  String
  content     String?
  imageUrl    String?
  altText     String?
  audioUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  authorId    String
  isAccepted  Boolean       @default(false)
  upvotes     Int           @default(0)
  downvotes   Int           @default(0)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question    ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  votes       ForumVote[]
  reports     ForumReport[]

  @@index([questionId])
  @@index([authorId])
  @@index([deletedAt])

  @@map("forum_answers")
}

model ForumVote {
  id        String   @id @default(uuid())
  answerId  String
  userId    String
  type      VoteType
  createdAt DateTime @default(now())
  answer    ForumAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
  @@index([userId])
  @@unique([answerId, userId])
  @@map("forum_votes")
}

model ForumTag {
  id    String @id @default(uuid())
  name  String @unique
  questions ForumQuestion[] @relation("QuestionTags")
  @@map("forum_tags")
}

model ForumReport {
  id         String   @id @default(uuid())
  reporterId String
  questionId String?
  answerId   String?
  reason     String
  // This model previously had no status at all, so the admin panel resolved a
  // report by DELETEing the row. That destroyed the audit trail an appeal needs
  // and made the published response-time SLA unmeasurable for forum content.
  status         ReportStatus   @default(PENDING)
  referenceCode  String?        @unique
  severity       ReportSeverity @default(MEDIUM)
  acknowledgedAt DateTime?
  actionedAt     DateTime?
  reviewedBy     String?        // admin email
  reviewedAt     DateTime?
  createdAt  DateTime @default(now())
  reporter   User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  question   ForumQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     ForumAnswer?   @relation(fields: [answerId],   references: [id], onDelete: Cascade)
  @@index([status, createdAt(sort: Desc)])
  @@map("forum_reports")
}

enum Role {
  pwd
  caregiver
  therapist
  ngo
  volunteer
  student
  mentor
}

enum ReportTargetType {
  USER
  MESSAGE
  GROUP
}

enum ReportReason {
  CSAE                    // child sexual abuse and exploitation — priority queue
  SELF_HARM
  VIOLENCE
  HARASSMENT
  HATE_SPEECH
  SEXUAL_CONTENT
  PRIVACY_VIOLATION       // doxxing, sharing another member's disclosures
  HEALTH_MISINFORMATION
  SCAM_FRAUD
  ILLEGAL_ACTIVITY
  IMPERSONATION
  IP_INFRINGEMENT
  BAN_EVASION
  SPAM
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  phoneNo         String?
  lastSeen        DateTime?
  isEmailVerified Boolean   @default(false)
  loginAttempts   Int       @default(0)
  lockedUntil     DateTime?
  dateOfBirth     DateTime?
  roles           Role[]    @default([])
  profileComplete Boolean   @default(false)
  deletedAt       DateTime?

  // Suspension / ban state — owned by user-svc. Kept here only so forum-svc's
  // `db push` doesn't drop these columns from the shared `users` table.
  isSuspended      Boolean   @default(false)
  suspendedUntil   DateTime?
  suspensionReason String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Auth Relations
  refreshTokens           RefreshToken[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userProfile             UserProfile?

  // Forum Relations
  forumQuestions ForumQuestion[]
  forumAnswers   ForumAnswer[]
  forumReports   ForumReport[]
  forumStats     ForumUserStats?
  bookmarks      Bookmark[]
  notifications  Notification[]

  // user-svc-owned relations — NOT used by forum-svc's own code. Declared
  // here only so `prisma db push` sees the full physical `users` table
  // (shared with user-svc in the `public` schema) and doesn't reconcile away
  // columns/tables it doesn't recognize. Keep in sync with user-svc's
  // schema.prisma if that model's shape changes.
  mentorProfile MentorProfile?
  givenReviews  MentorReview[] @relation("ReviewerRelation")
  deviceTokens  DeviceToken[]
  filedReports  UserReport[]   @relation("ReporterRelation")
  consents      UserConsent[]
  guardianAttestations GuardianAttestation[] @relation("GuardianRelation")
  grievances           GrievanceTicket[]
  appeals              Appeal[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────
// user-svc-owned tables (public schema) — stub mirrors.
// forum-svc never queries these directly; they exist purely so
// `prisma db push` doesn't drop them as "extraneous" to this schema.
// Keep field-for-field in sync with services/user-svc/prisma/schema.prisma.
// ─────────────────────────────────────────────
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Event {
  id                 String   @id @default(uuid())
  title              String
  category           String
  location           String
  date               String
  time               String?
  image              String
  description        String
  spots              Int      @default(50)
  buttonType         String   @default("filled")
  externalUrl        String
  organizer          String   @default("DigiAbility Admin")
  accessibility_tags String   @default("")
  status             String   @default("published")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("events")
}

model MentorProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  bio                   String?
  skills                String[]
  disabilitySpecialties String[]
  isAvailable           Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews               MentorReview[]

  @@index([isAvailable])
  @@map("mentor_profiles")
}

model MentorReview {
  id         String        @id @default(uuid())
  mentorId   String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  mentor     MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  reviewer   User          @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([mentorId, reviewerId])
  @@index([mentorId])
  @@map("mentor_reviews")
}

model UserReport {
  id          String           @id @default(uuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String           // userId | messageId | conversationId
  reason      ReportReason
  details     String?          // optional free-text, max 500 chars
  status      ReportStatus     @default(PENDING)
  // Short human-readable ticket reference. The Community Guidelines promise the
  // reporter "a reference number", so this is surfaced in the confirmation.
  // Nullable to match ForumReport and chat.Report, and so adding this column
  // doesn't require backfilling rows that predate it. The service always sets it.
  referenceCode  String?       @unique
  severity       ReportSeverity @default(MEDIUM)
  // SLA tracking for the published "How we respond to reports" table. Without
  // these the promised acknowledgement and action deadlines are unmeasurable.
  acknowledgedAt DateTime?
  actionedAt     DateTime?
  reviewedBy  String?          // admin userId who reviewed
  reviewedAt  DateTime?
  actionTaken String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter User @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("user_reports")
}

model ForumUserStats {
  id             String    @id @default(uuid())
  userId         String    @unique
  reputation     Int       @default(0)
  isSuspended    Boolean   @default(false)
  suspendedUntil DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("forum_user_stats")
}

model Bookmark {
  id         String        @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("forum_bookmarks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  relatedId String?
  // For enforcement notices (MODERATION_WARNING / MODERATION_BAN / content
  // removal): the admin_audit_log entry that produced this notice.
  //
  // Without it an appeal has nothing to point at, and there is no way to tell
  // which admin made the decision — so no way to honour the Community
  // Guidelines' promise that an appeal is reviewed by someone not involved in
  // the original decision.
  auditLogId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("forum_notifications")
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  username  String?   @unique
  fullName  String?
  dob       DateTime?
  gender    String?
  city      String?
  state     String?

  // Address — mirror of user-svc; keep in sync so db push won't drop them.
  addressLine1     String?
  streetArea       String?
  pincode          String?
  locationDistrict String?

  // PwD Fields
  disabilityType  String?
  disabilitySince Int?
  supportNeeded   String?

  // Caregiver Fields
  carePersonName     String?
  careRelation       String?
  careDob            DateTime?
  careDisabilityType String?

  // Therapist Fields
  speciality        String?
  organization      String?
  yearsOfExperience Int?

  // NGO Fields
  ngoName           String?
  ngoRole           String?
  district          String?

  // Skill Trainer Fields
  skillsTaught     String?
  teachingMode     String? // "physical" | "online" | "both"
  trainingLocation String?
  trainingAddress  String?

  // Verification (for Therapist / NGO roles)
  verificationStatus String?  @default("pending") // pending, verified, rejected
  verificationDoc    String?  // URL to uploaded document

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([username])
  @@map("user_profiles")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  attempts  Int      @default(0)  // failed attempt counter for brute-force protection
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   // stored as SHA-256 hash
  // UUID shared across all rotations of one session. createRefreshToken()
  // always passes this explicitly; the default only backfills rows that
  // existed before family tracking (each becomes its own single-token family).
  familyId  String   @default(dbgenerated("(gen_random_uuid())::text"))
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  // The login session this token belongs to. Null only on rows that predate
  // sessions and belonged to no live family at migration time.
  sessionId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

// One row per login (device). Its id is the `sid` claim in every access token
// minted for it, so revoking the row invalidates those tokens immediately —
// every service checks the session on each request (VAPT M-003 / CWE-613).
// refresh_tokens keeps the rotation history for reuse detection.
model Session {
  id               String    @id @default(uuid())
  userId           String
  // SHA-256 of the current (latest) refresh token for this session.
  refreshTokenHash String
  userAgent        String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  // logout | logout_all | password_reset | reuse_detected | account_deleted
  revokedReason    String?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  attempts  Int      @default(0)  // mirror of user-svc — keep in sync so db push won't drop it
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// user-svc-owned table — stub mirror, see services/user-svc/prisma/schema.prisma.
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminEmail String   // email of the admin who acted
  action     String   // dismiss | remove_content | warn_user | ban_user | suspend | unsuspend | keyword_add | keyword_delete
  targetType String   // user_report | ai_flag | forum_post | forum_answer | chat_message | user | keyword
  targetId   String   // ID of the item that was acted on
  reason     String?  // optional free-text justification
  detail     String?  // JSON for extra context (e.g. ban duration)
  ipAddress  String?  // request IP of the acting admin, truncated for minimisation
  createdAt  DateTime @default(now())

  @@index([adminEmail])
  @@index([targetType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}
// ─────────────────────────────────────────────
// user-svc-owned enums (public schema) — stub mirrors.
// ─────────────────────────────────────────────

enum ConsentType {
  DATA_PROCESSING       // required — core service cannot operate without this
  TERMS_OF_USE          // required — accepted at registration, re-accepted on version bump
  COMMUNITY_GUIDELINES  // required — accepted alongside the Terms
  GUARDIAN_CONSENT      // guardian attestation for a Care Circle member (DPDP §9)
  PUSH_NOTIFICATIONS    // optional — device-push alerts
  MARKETING             // optional — newsletters and promotional emails
}

enum KeywordSeverity {
  LOW
  MEDIUM
  HIGH
}

enum KeywordAction {
  flag
  block
}

enum KeywordCategory {
  PROFANITY
  HATE_SPEECH
  HARASSMENT
  SPAM
  SELF_HARM
  MISINFORMATION
  OTHER
}

enum KeywordMatchType {
  EXACT     // whole-word boundary match
  CONTAINS  // substring match (on normalized text)
}

enum FlagStatus {
  PENDING    // awaiting human review
  REVIEWED   // seen by moderator, no action taken
  ACTIONED   // content removed / user warned
  DISMISSED  // false positive, cleared
}

// ─────────────────────────────────────────────
// user-svc-owned tables (public schema) — stub mirrors, batch 2.
// These were absent from this file entirely, which meant a
// `prisma db push` from forum-svc would have DROPPED them —
// including user_consents, the DPDP consent record store.
// ─────────────────────────────────────────────

model UserConsent {
  id          String      @id @default(uuid())
  userId      String
  consentType ConsentType
  accepted    Boolean
  version     String      // policy version date, e.g. "2024-01-01"
  ipAddress   String?     // IP at time of consent (truncated to /24 for privacy)
  acceptedAt  DateTime?
  withdrawnAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@index([userId])
  @@map("user_consents")
}

model DisabilityType {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name      String
  code      String   @unique
  status    String   @default("Active")
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @db.Timestamptz

  @@map("disability_types")
}

model AdminNotificationLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  message   String
  type      String   @default("INFO")
  audience  String   @default("ALL")
  sentCount Int      @default(0) @map("sent_count")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_notification_logs")
}

model AdminNotificationSettings {
  id                       String    @id @default("default")
  emailNewUsers            Boolean?  @default(true) @map("email_new_users")
  emailContentReports      Boolean?  @default(true) @map("email_content_reports")
  emailFailedTransactions  Boolean?  @default(true) @map("email_failed_transactions")
  emailSystemErrors        Boolean?  @default(true) @map("email_system_errors")
  emailWeeklyDigest        Boolean?  @default(true) @map("email_weekly_digest")
  pushEnabled              Boolean?  @default(true) @map("push_enabled")
  pushModerationQueue      Boolean?  @default(true) @map("push_moderation_queue")
  pushUserMilestones       Boolean?  @default(true) @map("push_user_milestones")
  pushCommunityHighlights  Boolean?  @default(true) @map("push_community_highlights")
  pushSystemMaintenance    Boolean?  @default(true) @map("push_system_maintenance")
  smsCriticalOnly          Boolean?  @default(true) @map("sms_critical_only")
  smsDailySummary          Boolean?  @default(true) @map("sms_daily_summary")
  smsPromotional           Boolean?  @default(false) @map("sms_promotional")
  phoneNumber              String?   @default("") @map("phone_number")
  frequency                String?   @default("Real-time")
  quietStart               String?   @default("20:00") @map("quiet_start")
  quietEnd                 String?   @default("08:00") @map("quiet_end")
  updatedAt                DateTime? @default(now()) @map("updated_at") @db.Timestamptz

  @@map("admin_notification_settings")
}

model BannedKeyword {
  id        String           @id @default(uuid())
  phrase    String           @unique
  severity  KeywordSeverity  @default(MEDIUM)
  action    KeywordAction    @default(block)
  category  KeywordCategory  @default(OTHER)
  matchType KeywordMatchType @default(CONTAINS)
  isActive  Boolean          @default(true)
  createdBy String?          // admin email
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([isActive])
  @@index([category])
  @@map("banned_keywords")
}

model ModerationFlag {
  id          String     @id @default(uuid())
  contentType String     // 'chat_message' | 'forum_question' | 'forum_answer'
  contentId   String     // messageId | questionId | answerId
  userId      String     // content author (for ban/warn lookup)
  text        String?    // first 500 chars of content (for review without cross-service query)
  provider    String     // 'openai' | 'noop'
  score       Float      // 0-1 max toxicity probability
  categories  String[]   // detected violation categories
  status      FlagStatus @default(PENDING)
  reviewedBy  String?    // admin email
  reviewedAt  DateTime?
  rawResponse String?    // JSON snippet of API response (for debugging)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([contentType, contentId])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("moderation_flags")
}

enum ReportSeverity {
  CRITICAL // CSAE, credible threats, trafficking — act immediately
  HIGH     // self-harm risk — acknowledge 4h
  ELEVATED // non-consensual imagery, impersonation — acknowledge and act 24h
  MEDIUM   // harassment, hate speech, sexual content — ack 24h, act 72h
  LOW      // spam and lower severity — ack 72h, act 7d
}

enum GrievanceStatus {
  RECEIVED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AppealStatus {
  SUBMITTED
  UNDER_REVIEW
  UPHELD      // original decision stands
  OVERTURNED  // original decision reversed
  REJECTED    // out of window, or a repeat of a decided appeal
}

enum RemovedContentType {
  CHAT_MESSAGE
  FORUM_QUESTION
  FORUM_ANSWER
  PROFILE_FIELD
}

model RegistrationRecord {
  id           String   @id @default(uuid())
  userId       String   @unique
  email        String
  phoneNo      String?
  registeredAt DateTime
  cancelledAt  DateTime @default(now())
  // Purge deadline, enforced by the retention worker. cancelledAt + 180 days.
  purgeAfter   DateTime

  // Cross-service erasure state. chat-svc and forum-svc own their own schemas,
  // so their cleanup is an HTTP call that can fail while the local deletion has
  // already committed. Null means "not yet confirmed done"; the retention
  // worker retries those on its daily pass rather than losing the obligation.
  chatCleanupAt   DateTime?
  forumCleanupAt  DateTime?
  cleanupAttempts Int       @default(0)

  @@index([purgeAfter])
  @@index([chatCleanupAt])
  @@index([forumCleanupAt])
  @@map("registration_records")
}

model GuardianAttestation {
  id             String   @id @default(uuid())
  // The account holder making the confirmation.
  guardianUserId String
  // Who the confirmation is about. Free-form because the subject usually has no
  // account of their own — that is the point of the Care Circle arrangement.
  subjectName    String
  subjectIsMinor Boolean  @default(true)
  relationship   String   // Parent | Guardian | Spouse | Sibling | Child | Other
  conversationId String?  // the Care Circle, owned by chat-svc's schema
  policyVersion  String
  ipAddress      String?  // truncated for minimisation, as with UserConsent
  attestedAt     DateTime @default(now())
  revokedAt      DateTime?

  guardian User @relation("GuardianRelation", fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@index([guardianUserId])
  @@index([conversationId])
  @@map("guardian_attestations")
}

model GrievanceTicket {
  id             String          @id @default(uuid())
  referenceCode  String          @unique
  // Nullable: a grievance may arrive from someone without an account.
  userId         String?
  contactEmail   String
  category       String
  subject        String
  body           String
  status         GrievanceStatus @default(RECEIVED)
  receivedAt     DateTime        @default(now())
  acknowledgedAt DateTime?       // SLA: within 24h of receivedAt
  resolvedAt     DateTime?       // SLA: within 15 days of receivedAt
  resolutionNote String?
  assignedTo     String?         // admin email
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([acknowledgedAt])
  @@map("grievance_tickets")
}

model Appeal {
  id             String       @id @default(uuid())
  referenceCode  String       @unique
  appellantId    String
  // What is being appealed — an audit log entry, report, or moderation flag.
  targetType     String       // admin_audit_log | user_report | moderation_flag
  targetId       String
  grounds        String
  status         AppealStatus @default(SUBMITTED)
  submittedAt    DateTime     @default(now())
  // Response deadline: submittedAt + 14 days, or + 7 if the account is suspended.
  dueBy          DateTime
  respondedAt    DateTime?
  // Admin email. Must differ from the original decision's adminEmail.
  reviewedBy     String?
  decisionNote   String?

  appellant User @relation(fields: [appellantId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([targetType, targetId])
  @@map("appeals")
}

model MessageAccessLog {
  id             String   @id @default(uuid())
  adminEmail     String
  // What kind of read this was:
  //   context_view   — deliberately opening a conversation to read the messages
  //                    around a reported one. The deep read that most needs a trail.
  //   queue_listing  — the moderation queue rendering reported-message snapshots.
  //   report_detail  — a single report opened for review.
  accessType     String   @default("context_view")
  // Null for a queue listing, which spans many conversations rather than one.
  conversationId String?
  // Which messages were exposed — ids, or a sequence range for a context window.
  messageIds     String[]
  sequenceFrom   BigInt?
  sequenceTo     BigInt?
  // Why the access was lawful: the report or grievance being investigated.
  justification  String
  reportId       String?
  ipAddress      String?
  accessedAt     DateTime @default(now())

  @@index([adminEmail, accessedAt(sort: Desc)])
  @@index([conversationId])
  @@index([accessType, accessedAt(sort: Desc)])
  @@map("message_access_logs")
}

model RemovedContentRecord {
  id             String             @id @default(uuid())
  contentType    RemovedContentType
  contentId      String
  // Immutable snapshot taken at removal time.
  contentSnapshot String
  authorId       String
  conversationId String?            // for chat content
  removedBy      String             // admin email
  reason         String?
  // The report that prompted removal, where there was one. Null for proactive
  // removals, which is exactly the case the report-snapshot approach missed.
  sourceReportId String?
  removedAt      DateTime           @default(now())
  purgeAfter     DateTime           // removedAt + 180 days

  @@index([purgeAfter])
  @@index([authorId])
  @@index([contentType, contentId])
  @@map("removed_content_records")
}

