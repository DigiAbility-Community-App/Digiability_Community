generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuestionStatus {
  SOLVED
  UNSOLVED
}

enum VoteType {
  UP
  DOWN
}

model ForumQuestion {
  id           String          @id @default(uuid())
  title        String
  description  String?
  category     String
  tags         ForumTag[]      @relation("QuestionTags")
  imageUrl     String?
  altText      String?
  audioUrl     String?
  views        Int             @default(0)
  answerCount  Int             @default(0)
  status       QuestionStatus  @default(UNSOLVED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  authorId     String
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers      ForumAnswer[]
  reports      ForumReport[]
  bookmarks    Bookmark[]

  @@index([title])
  @@index([category])
  @@index([createdAt])
  @@index([authorId])
  @@index([deletedAt])

  @@map("forum_questions")
}

model ForumAnswer {
  id          String        @id @default(uuid())
  questionId  String
  content     String?
  imageUrl    String?
  altText     String?
  audioUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  authorId    String
  isAccepted  Boolean       @default(false)
  upvotes     Int           @default(0)
  downvotes   Int           @default(0)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question    ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  votes       ForumVote[]
  reports     ForumReport[]

  @@index([questionId])
  @@index([authorId])
  @@index([deletedAt])

  @@map("forum_answers")
}

model ForumVote {
  id        String   @id @default(uuid())
  answerId  String
  userId    String
  type      VoteType
  createdAt DateTime @default(now())
  answer    ForumAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([answerId])
  @@index([userId])
  @@unique([answerId, userId])
  @@map("forum_votes")
}

model ForumTag {
  id    String @id @default(uuid())
  name  String @unique
  questions ForumQuestion[] @relation("QuestionTags")
  @@map("forum_tags")
}

model ForumReport {
  id         String   @id @default(uuid())
  reporterId String
  questionId String?
  answerId   String?
  reason     String
  createdAt  DateTime @default(now())
  reporter   User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  question   ForumQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     ForumAnswer?   @relation(fields: [answerId],   references: [id], onDelete: Cascade)
  @@map("forum_reports")
}

enum Role {
  pwd
  caregiver
  therapist
  ngo
  volunteer
  student
  mentor
}

enum ReportTargetType {
  USER
  MESSAGE
  GROUP
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  INAPPROPRIATE_CONTENT
  MISINFORMATION
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  phoneNo         String?
  lastSeen        DateTime?
  isEmailVerified Boolean   @default(false)
  roles           Role[]    @default([])
  profileComplete Boolean   @default(false)
  deletedAt       DateTime?

  // Suspension / ban state — owned by user-svc. Kept here only so forum-svc's
  // `db push` doesn't drop these columns from the shared `users` table.
  isSuspended      Boolean   @default(false)
  suspendedUntil   DateTime?
  suspensionReason String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Auth Relations
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userProfile             UserProfile?

  // Forum Relations
  forumQuestions ForumQuestion[]
  forumAnswers   ForumAnswer[]
  forumReports   ForumReport[]
  forumStats     ForumUserStats?
  bookmarks      Bookmark[]
  notifications  Notification[]

  // user-svc-owned relations — NOT used by forum-svc's own code. Declared
  // here only so `prisma db push` sees the full physical `users` table
  // (shared with user-svc in the `public` schema) and doesn't reconcile away
  // columns/tables it doesn't recognize. Keep in sync with user-svc's
  // schema.prisma if that model's shape changes.
  mentorProfile MentorProfile?
  givenReviews  MentorReview[] @relation("ReviewerRelation")
  deviceTokens  DeviceToken[]
  filedReports  UserReport[]   @relation("ReporterRelation")

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────
// user-svc-owned tables (public schema) — stub mirrors.
// forum-svc never queries these directly; they exist purely so
// `prisma db push` doesn't drop them as "extraneous" to this schema.
// Keep field-for-field in sync with services/user-svc/prisma/schema.prisma.
// ─────────────────────────────────────────────
model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Event {
  id                 String   @id @default(uuid())
  title              String
  category           String
  location           String
  date               String
  time               String?
  image              String
  description        String
  spots              Int      @default(50)
  buttonType         String   @default("filled")
  externalUrl        String
  organizer          String   @default("DigiAbility Admin")
  accessibility_tags String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("events")
}

model MentorProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  bio                   String?
  skills                String[]
  disabilitySpecialties String[]
  isAvailable           Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews               MentorReview[]

  @@index([isAvailable])
  @@map("mentor_profiles")
}

model MentorReview {
  id         String        @id @default(uuid())
  mentorId   String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  mentor     MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  reviewer   User          @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([mentorId, reviewerId])
  @@index([mentorId])
  @@map("mentor_reviews")
}

model UserReport {
  id          String           @id @default(uuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  details     String?
  status      ReportStatus     @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  actionTaken String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  reporter User @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("user_reports")
}

model ForumUserStats {
  id             String    @id @default(uuid())
  userId         String    @unique
  reputation     Int       @default(0)
  isSuspended    Boolean   @default(false)
  suspendedUntil DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("forum_user_stats")
}

model Bookmark {
  id         String        @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("forum_bookmarks")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // ANSWER, ACCEPTED, MENTION, LIKE, MODERATION
  title     String
  message   String
  read      Boolean  @default(false)
  relatedId String?  // ID of related question
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("forum_notifications")
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  username  String?   @unique
  fullName  String?
  dob       DateTime?
  gender    String?
  city      String?
  state     String?

  // PwD Fields
  disabilityType  String?
  disabilitySince Int?
  supportNeeded   String?

  // Caregiver Fields
  carePersonName     String?
  careRelation       String?
  careDob            DateTime?
  careDisabilityType String?

  // Therapist Fields
  speciality        String?
  organization      String?
  yearsOfExperience Int?

  // NGO Fields
  ngoName           String?
  ngoRole           String?
  district          String?

  // Verification (for Therapist / NGO roles)
  verificationStatus String?  @default("pending") // pending, verified, rejected
  verificationDoc    String?  // URL to uploaded document

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([username])
  @@map("user_profiles")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  attempts  Int      @default(0)  // failed attempt counter for brute-force protection
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   // stored as SHA-256 hash
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   // stored as SHA-256 hash
  expiresAt DateTime
  attempts  Int      @default(0)  // mirror of user-svc — keep in sync so db push won't drop it
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// user-svc-owned table — stub mirror, see services/user-svc/prisma/schema.prisma.
model AdminAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?
  action    String
  reason    String?
  message   String?
  createdAt DateTime @default(now())

  @@map("admin_audit_log")
}
